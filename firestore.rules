rules_version = '2';
// Prototype rules tested against the app's Web SDK queries and attack cases.
// days/{id}: date (immutable), label100, status enum, cutoffAt timestamp,
// menuCount1..60, updatedAt. dishes/{hash}: name160, price int, active bool,
// updatedAt. orders/{hash}: ownerId128/name100 (immutable except controlled
// owner transfer), dishId64hex/dish160, price int, quantity1..30, note300,
// paid/cancelled bool, immutable createdAt, updatedAt; timestamps use request.time.
// admins/{uid}: enabled=true, Console bootstrap then primary-admin management. accountLinks/{sourceUid}:
// targetUid, createdAt, expiresAt<=10min. settings/payment: qrUrl, updatedAt.
// pickupDraws/{YYYY-MM-DD}: date/weekStart/dayId, count1..10, candidateCount<=500,
// selectedKeys (unique), selectedNames and previousCounts (parallel lists<=10;
// key/name strings1..100, previousCount0..6),
// createdBy128, createdAt=request.time, version=1. Admin create only; immutable.
// userProfiles/{uid}: displayName/preferredName0..100, email0..254 matching
// verified token, provider anonymous/google.com, immutable createdAt, lastSeenAt.
// Private to owner and admins. userAccess/{uid}: blocked bool, updatedBy128,
// updatedAt. admins new writes: enabled bool, updatedBy128, updatedAt.
// Primary admin alone changes other roles; no self/primary lockout or deletes.
// Every other collection, including the legacy server schema, stays denied.
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function googleUser(){return signedIn() && request.auth.token.get('email_verified',false) == true && request.auth.token.firebase.sign_in_provider == 'google.com';}
  function admin(){return googleUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;}
  function primaryAdmin(){return admin() && request.auth.uid == 'PRIMARY_ADMIN_UID_HERE';}
  function validUid(uid){return uid is string && uid.matches('^[A-Za-z0-9_-]{1,128}$');}
  function activeUser(){return !exists(/databases/$(database)/documents/userAccess/$(request.auth.uid)) || get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.blocked == false;}
  function validText(value,max){return value is string && value.size()>0 && value.size()<=max && value == value.trim();}
  // Match the browser's name IDs for Vietnamese names beginning with Đ.
  function hash(value){return hashing.sha256(value.lower().replace('Đ','đ')).toHexString().lower();}
  function openDay(dayId){
   let day=get(/databases/$(database)/documents/days/$(dayId)).data;
   return day.status == 'open' || (day.status == 'auto' && request.time < day.cutoffAt);
  }
  function validDay(d){
   return d.keys().hasAll(['date','label','status','cutoffAt','menuCount','updatedAt']) && d.keys().hasOnly(['date','label','status','cutoffAt','menuCount','updatedAt'])
    && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validText(d.label,100) && d.status in ['auto','open','closed']
    && d.menuCount is int && d.menuCount>=1 && d.menuCount<=60
    && d.cutoffAt is timestamp && d.cutoffAt == timestamp.date(int(d.date.split('-')[0]),int(d.date.split('-')[1]),int(d.date.split('-')[2])) + duration.value(150,'m')
    && d.updatedAt == request.time;
  }
  function validDish(d,dishId){
   return d.keys().hasAll(['name','price','active','updatedAt']) && d.keys().hasOnly(['name','price','active','updatedAt']) && validText(d.name,160) && dishId == hash(d.name)
    && d.price is int && d.price>=1000 && d.price<=1000000 && d.active is bool && d.updatedAt == request.time;
  }
  function validOrder(d,orderId){
   return d.keys().hasAll(['name','ownerId','dishId','dish','price','quantity','note','paid','cancelled','createdAt','updatedAt'])
    && d.keys().hasOnly(['name','ownerId','dishId','dish','price','quantity','note','paid','cancelled','createdAt','updatedAt'])
    && validText(d.name,100) && orderId == hash(d.name) && d.ownerId is string && d.ownerId.size()>0 && d.ownerId.size()<=128
    && d.dishId is string && d.dishId.matches('^[a-f0-9]{64}$') && validText(d.dish,160) && d.price is int && d.price>=1000 && d.price<=1000000
    && d.quantity is int && d.quantity>=1 && d.quantity<=30 && d.note is string && d.note.size()<=300 && d.paid is bool && d.cancelled is bool
    && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function menuPrice(dayId,d){
   let item=get(/databases/$(database)/documents/days/$(dayId)/dishes/$(d.dishId)).data;
   return item.active == true && d.dish == item.name && d.price == item.price;
  }
  function samePrice(d){return d.dishId == resource.data.dishId && d.dish == resource.data.dish && d.price == resource.data.price;}
  function recipient(sourceUid){
   let path=/databases/$(database)/documents/accountLinks/$(sourceUid);
   return googleUser() && exists(path) && get(path).data.targetUid == request.auth.uid && request.time < get(path).data.expiresAt;
  }
  function ownOrder(){return signedIn() && resource.data.ownerId == request.auth.uid;}
  function parentExists(dayId){return exists(/databases/$(database)/documents/days/$(dayId));}
  function correctPayment(d){return (samePrice(d) && d.quantity == resource.data.quantity && d.cancelled == resource.data.cancelled && !resource.data.cancelled) ? d.paid == resource.data.paid : d.paid == false;}
  function validLink(d,sourceUid){
   return d.keys().hasAll(['targetUid','createdAt','expiresAt']) && d.keys().hasOnly(['targetUid','createdAt','expiresAt'])
    && signedIn() && sourceUid == request.auth.uid && request.auth.token.firebase.sign_in_provider == 'anonymous'
    && d.targetUid is string && d.targetUid.matches('^[A-Za-z0-9_-]{1,128}$') && d.targetUid != sourceUid
    && d.createdAt == request.time && d.expiresAt is timestamp && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(10,'m');
  }
  function validPayment(d){
   return d.keys().hasAll(['qrUrl','updatedAt']) && d.keys().hasOnly(['qrUrl','updatedAt']) && d.qrUrl is string && d.qrUrl.size()<=200000
    && (d.qrUrl == '' || (d.qrUrl.size()<=2000 && d.qrUrl.matches('https://[^ ]+')) || d.qrUrl.matches('data:image/(png|jpeg);base64,[A-Za-z0-9+/=]+')) && d.updatedAt == request.time;
  }
  function pickupDate(value){let parts=value.split('-');return timestamp.date(int(parts[0]),int(parts[1]),int(parts[2]));}
  function validPickupPerson(person,name,previous){
   return name is string && name.matches('^[^\r\n]{1,100}$')
    && person is string && person.matches('^[^\r\n]{1,100}$')
    && previous is int && previous>=0 && previous<=6;
  }
  function validPickupItem(keys,names,counts,count,i){return count<=i || validPickupPerson(keys[i],names[i],counts[i]);}
  function validPickupTime(d){
   let day=pickupDate(d.date);
   let week=pickupDate(d.weekStart);
   return (week.toMillis()-timestamp.date(1970,1,5).toMillis()) % 604800000 == 0
    && week<=day && day<week+duration.value(7,'d')
    && request.time >= day-duration.value(7,'h') && request.time < day+duration.value(17,'h');
  }
  function validPickup(d,date){
   let fields=d.keys();
   let keys=d.selectedKeys;
   let names=d.selectedNames;
   let counts=d.previousCounts;
   let count=d.count;
   return fields.size()==11 && fields.hasOnly(['date','weekStart','dayId','count','candidateCount','selectedNames','previousCounts','selectedKeys','createdBy','createdAt','version'])
    && date == d.date && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && validPickupTime(d)
    && d.dayId is string && d.dayId.matches('^[A-Za-z0-9_-]{1,100}$')
    && count is int && count>=1 && count<=10 && d.candidateCount is int && d.candidateCount>=count && d.candidateCount<=500
    && names is list && names.size()==count && counts is list && counts.size()==count
    && keys is list && keys.size()==count && keys.toSet().size()==count
    && validPickupItem(keys,names,counts,count,0) && validPickupItem(keys,names,counts,count,1) && validPickupItem(keys,names,counts,count,2) && validPickupItem(keys,names,counts,count,3) && validPickupItem(keys,names,counts,count,4)
    && validPickupItem(keys,names,counts,count,5) && validPickupItem(keys,names,counts,count,6) && validPickupItem(keys,names,counts,count,7) && validPickupItem(keys,names,counts,count,8) && validPickupItem(keys,names,counts,count,9)
    && d.createdBy == request.auth.uid && d.createdAt == request.time && d.version is int && d.version == 1
    && exists(/databases/$(database)/documents/days/$(d.dayId)) && get(/databases/$(database)/documents/days/$(d.dayId)).data.date == d.date
    && get(/databases/$(database)/documents/days/$(d.dayId)).data.status == 'closed';
  }
  match /pickupDraws/{date}{allow read: if signedIn();allow create: if admin() && validPickup(request.resource.data,date);allow update,delete: if false;}
  function validProfile(d){
   return d.keys().hasAll(['displayName','preferredName','email','provider','createdAt','lastSeenAt']) && d.keys().hasOnly(['displayName','preferredName','email','provider','createdAt','lastSeenAt'])
    && d.displayName is string && d.displayName.size()<=100 && d.displayName==d.displayName.trim()
    && d.preferredName is string && d.preferredName.size()<=100 && d.preferredName==d.preferredName.trim()
    && d.email is string && d.email.size()<=254 && d.provider in ['anonymous','google.com']
    && ((d.provider=='anonymous' && request.auth.token.firebase.sign_in_provider=='anonymous' && d.email=='')
     || (d.provider=='google.com' && googleUser() && d.email.size()>0 && d.email==request.auth.token.email))
    && d.createdAt is timestamp && d.lastSeenAt==request.time;
  }
  function validUserAccess(d){return d.keys().hasAll(['blocked','updatedBy','updatedAt']) && d.keys().hasOnly(['blocked','updatedBy','updatedAt']) && d.blocked is bool && d.updatedBy==request.auth.uid && validUid(d.updatedBy) && d.updatedAt==request.time;}
  function validAdminRole(d){return d.keys().hasAll(['enabled','updatedBy','updatedAt']) && d.keys().hasOnly(['enabled','updatedBy','updatedAt']) && d.enabled is bool && d.updatedBy==request.auth.uid && validUid(d.updatedBy) && d.updatedAt==request.time;}
  function canBlockUser(uid){return admin() && validUid(uid) && uid!=request.auth.uid && uid!='PRIMARY_ADMIN_UID_HERE' && (!existsAfter(/databases/$(database)/documents/admins/$(uid)) || getAfter(/databases/$(database)/documents/admins/$(uid)).data.enabled!=true);}
  function canChangeRole(uid,d){
   return primaryAdmin() && validUid(uid) && uid!=request.auth.uid && uid!='PRIMARY_ADMIN_UID_HERE' && validAdminRole(d)
    && (!d.enabled || (existsAfter(/databases/$(database)/documents/userProfiles/$(uid)) && getAfter(/databases/$(database)/documents/userProfiles/$(uid)).data.provider=='google.com'
     && (!existsAfter(/databases/$(database)/documents/userAccess/$(uid)) || getAfter(/databases/$(database)/documents/userAccess/$(uid)).data.blocked==false)));
  }
  match /userProfiles/{uid}{
   allow get: if signedIn() && (request.auth.uid==uid || admin());allow list: if admin();
   allow create: if signedIn() && uid==request.auth.uid && validUid(uid) && validProfile(request.resource.data) && request.resource.data.createdAt==request.time;
   allow update: if signedIn() && uid==request.auth.uid && validProfile(request.resource.data) && request.resource.data.createdAt==resource.data.createdAt;
   allow delete: if false;
  }
  match /userAccess/{uid}{
   allow get: if signedIn() && (request.auth.uid==uid || admin());allow list: if admin();
   allow create,update: if canBlockUser(uid) && validUserAccess(request.resource.data);allow delete: if false;
  }
  match /admins/{uid}{
   allow get: if (googleUser() && request.auth.uid==uid) || admin();allow list: if admin();
   allow create,update: if canChangeRole(uid,request.resource.data);allow delete: if false;
  }
  match /accountLinks/{sourceUid}{
   allow get: if signedIn() && (request.auth.uid == sourceUid || (resource != null && googleUser() && resource.data.targetUid == request.auth.uid));
   allow list,update: if false;
   allow create: if validLink(request.resource.data,sourceUid);
   allow delete: if signedIn() && (request.auth.uid == sourceUid || (googleUser() && resource.data.targetUid == request.auth.uid));
  }
  match /settings/payment{allow read: if signedIn();allow create,update: if admin() && validPayment(request.resource.data);allow delete: if false;}
  match /days/{dayId}{
   allow read: if signedIn();
   allow create: if admin() && dayId.matches('^[A-Za-z0-9_-]{1,100}$') && validDay(request.resource.data);
   allow update: if admin() && validDay(request.resource.data) && request.resource.data.date == resource.data.date;
   allow delete: if false;
   match /dishes/{dishId}{
    allow read: if signedIn() && parentExists(dayId);
    allow create,update: if admin() && getAfter(/databases/$(database)/documents/days/$(dayId)).data.date is string && validDish(request.resource.data,dishId);
    allow delete: if false;
   }
   match /orders/{orderId}{
    // All app visitors receive an anonymous Firebase session and may view meals.
    // Editing, cancellation, payment and ownership transfer remain checked below.
    allow get,list: if signedIn() && parentExists(dayId);
    allow create: if signedIn() && activeUser() && validOrder(request.resource.data,orderId) && request.resource.data.ownerId == request.auth.uid
     && request.resource.data.createdAt == request.time && request.resource.data.paid == false && request.resource.data.cancelled == false && openDay(dayId) && menuPrice(dayId,request.resource.data);
    allow update: if signedIn() && parentExists(dayId) && validOrder(request.resource.data,orderId) && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.name == resource.data.name && (
     (recipient(resource.data.ownerId) && request.resource.data.ownerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId','updatedAt']))
     || (request.resource.data.ownerId == resource.data.ownerId && (
      (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid','updatedAt']))
      || (((ownOrder() && (activeUser() || (request.resource.data.cancelled==true && request.resource.data.paid==false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled','paid','updatedAt'])))) || admin()) && openDay(dayId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dishId','dish','price','quantity','note','paid','cancelled','updatedAt'])
       && (samePrice(request.resource.data) || menuPrice(dayId,request.resource.data)) && (admin() || correctPayment(request.resource.data)))
     ))
    );
    allow delete: if false;
   }
  }
  match /{path=**}{allow read,write: if false;}
 }
}
