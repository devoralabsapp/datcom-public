# Copy to .env.local and fill in your Firebase Web app configuration.
# Web configuration only. Never put service account keys in this file.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)

# Optional legacy Google Sheets source. Leave blank to use only web data.
MEAL_SPREADSHEET_ID=
MEAL_SHEETS_START_YEAR=2025
